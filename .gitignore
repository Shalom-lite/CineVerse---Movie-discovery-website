# ============================================
# CineVerse .gitignore
# Keeps user submissions and junk out of Git
# ============================================

# User form submissions (created at runtime by PHP)
data/subscribers.json
data/messages.json

# OS junk files
.DS_Store
Thumbs.db
Desktop.ini

# Editor / IDE folders
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# Logs and temporary files
*.log
tmp/
temp/
